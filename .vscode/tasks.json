{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "next: dev",
            "type": "shell",
            "command": "pnpm dev",
            "isBackground": true,
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            },
            "problemMatcher": [
                {
                    "owner": "custom",
                    "pattern": {
                        "regexp": "^(.*)$",
                        "message": 1
                    },
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*",
                        "endsPattern": "(Ready in|Local:\\s+http://localhost:3000)"
                    }
                }
            ]
        }
    ]
}
